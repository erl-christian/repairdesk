generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum RepairStatus {
  PENDING_REVIEW
  ACCEPTED
  IN_PROGRESS
  WAITING_PARTS
  READY_FOR_PICKUP
  COMPLETED
  CANCELLED
}

enum ServiceMethod {
  TECHNICIAN_VISITS_CUSTOMER
  CUSTOMER_VISITS_TECHNICIAN
}

enum AttachmentUploader{
    CUSTOMER
    ADMIN
}

model RepairRequest {
  id                  String          @id @default(uuid())

  publicTicketNumber  String          @unique

  customerName        String
  phoneNumber         String
  email               String?

  deviceType          String
  deviceBrand         String?
  deviceModel         String?

  problemDescription  String

  serviceMethod       ServiceMethod

  municipality        String

  preferredDate       DateTime?
  preferredTime       String?
  timeline            RepairTimeline[]

  status              RepairStatus    @default(PENDING_REVIEW)
  images              RepairImage[]
  notes               RepairNote[]

  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
}

model Admin {
  id           String   @id @default(uuid())
  username     String   @unique
  email        String   @unique
  passwordHash String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model RepairTimeline {
  id              String @id @default(uuid())

  repairRequestId String
  repairRequest   RepairRequest @relation(fields: [repairRequestId], references: [id], onDelete: Cascade)

  status RepairStatus

  note String?

  createdAt DateTime @default(now())
}

model RepairImage {

  id String @id @default(uuid())

  repairRequestId String

  repairRequest RepairRequest @relation(fields:[repairRequestId],references:[id],onDelete:Cascade)

  imageUrl String

  uploadedBy AttachmentUploader

  createdAt DateTime @default(now())

}

model RepairNote {
  id String @id @default(uuid())

  repairRequestId String

  repairRequest RepairRequest @relation(fields: [repairRequestId], references: [id], onDelete: Cascade)

  note String @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}